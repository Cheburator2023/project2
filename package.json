		"@commitlint/cli": "19.8.0",
		"@commitlint/config-conventional": "19.8.0",
		"@types/lodash-es": "4.17.12",
		"@types/node": "22.13.14",
		"@types/react": "19.1.2",
		"@types/react-dom": "19.1.2",
		"babel-loader": "10.0.0",
		"browserslist-to-esbuild": "2.1.1",
