{
	"name": "smart_anketa_ui",
	"version": "1.0.0",
	"private": true,
	"workspaces": ["apps/*", "packages/*"],
	"release_logs": {
		"features": [],
		"fixes": [],
		"refactors": [],
		"hotfixes": []
	},
	"engines": {
		"npm": ">=10.0.0",
		"node": ">=20.0.0"
	},
	"packageManager": "npm@10.0.0",
	"scripts": {
		"dev:fullstack": "turbo run dev --parallel --no-cache",
		"dev:ui": "turbo run dev --filter=react-client",
		"dev:server:nest": "turbo run dev --filter=nestjs-server",
		"turbo:ls": "turbo ls",
		"build": "turbo run build",
		"lint": "turbo run lint",
		"biome": "npx @biomejs/biome check",
		"biome:fix": "npx @biomejs/biome check --log-level=error --diagnostic-level=error --fix --unsafe ./apps/react-client/src",
		"prepare": "husky"
	},
	"lint-staged": {
		"*.{ts,tsx}": ["biome check --files-ignore-unknown=true --colors=force"]
	},
	"devDependencies": {
		"@babel/preset-env": "7.27.2",
		"@babel/preset-react": "7.27.1",
		"@babel/preset-typescript": "7.27.1",
