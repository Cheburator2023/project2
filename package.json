		"husky": "9.1.7",
		"lint-staged": "15.5.0",
		"turbo": "2.4.4",
		"type-fest": "4.26.1",
		"typescript": "5.8.2"
	},
	"dependencies": {
		"@fontsource/inter": "5.2.5",
		"@hookform/resolvers": "3.9.0",
		"@module-federation/bridge-react": "0.14.3",
		"@react-keycloak/web": "3.4.0",
		"@sentry/react": "8.26.0",
		"@sentry/utils": "8.27.0",
		"@xyflow/react": "12.1.1",
		"@xyflow/system": "0.0.43",
		"ag-charts-community": "11.3.0",
