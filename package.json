{
	"name": "smart_anketa_ui",
	"version": "1.0.0",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"release_logs": {
		"features": [],
		"fixes": [],
		"refactors": [],
		"hotfixes": []
	},
	"engines": {
		"npm": ">=10.0.0",
		"node": ">=20.0.0"
	},
	"packageManager": "npm@10.0.0",
	"scripts": {
		"dev:fullstack": "turbo run dev --parallel --no-cache",
		"dev:fullstack:god": "turbo run dev:god --parallel --no-cache",
		"dev:ui": "turbo run dev --filter=react-client",
		"dev:ui:god": "turbo run dev:god --filter=react-client",
		"dev:server:nest:god": "turbo run dev:god --filter=nestjs-server",
		"dev:server:nest": "turbo run dev --filter=nestjs-server",
		"test:all": "turbo run test",
		"turbo:ls": "turbo ls",
		"build": "turbo run build",
		"lint": "turbo run lint",
		"biome": "npx @biomejs/biome@2.0.6 check",
		"biome:fix": "npx @biomejs/biome@2.0.6 check --log-level=error --diagnostic-level=error --unsafe --fix ./apps/react-client/src ./apps/nestjs-server/test ./apps/nestjs-server/src",
		"prepare": "husky",
		"codemod:testids": "node ./codemods/add_test_ids.ts io-dir=../apps/react-client/src --all",
		"codemod:testids:remove": "node ./codemods/add_test_ids.ts io-dir=../apps/react-client/src --all --remove",
		"sync:arch-presets": "node ./scripts/sync-v2-arch-component-presets.mjs"
	},
	"lint-staged": {
		"*.{ts,tsx}": [
			"biome check --files-ignore-unknown=true --colors=force"
		]
	},
	"devDependencies": {
		"@babel/preset-env": "7.27.2",
		"@babel/preset-react": "7.27.1",
		"@babel/preset-typescript": "7.27.1",
		"@biomejs/biome": "2.0.6",
		"@commitlint/cli": "19.8.0",
		"@commitlint/config-conventional": "19.8.0",
		"@types/lodash-es": "4.17.12",
		"@types/node": "22.13.14",
		"babel-loader": "10.0.0",
		"browserslist-to-esbuild": "2.1.1",
		"cross-env": "7.0.3",
		"dockview-react": "^6.3.0",
		"husky": "9.1.7",
		"jscodeshift": "17.3.0",
		"lint-staged": "15.5.0",
		"turbo": "2.4.4",
		"type-fest": "4.26.1",
		"typescript": "5.8.2"
	},
	"dependencies": {
		"@fontsource/inter": "5.2.5",
		"@hookform/resolvers": "3.9.0",
		"@minoru/react-dnd-treeview": "^3.5.4",
		"@module-federation/bridge-react": "0.14.3",
		"@react-keycloak/web": "3.4.0",
		"@sentry/react": "8.26.0",
		"@sentry/utils": "8.27.0",
		"@xyflow/react": "12.10.2",
		"@xyflow/system": "0.0.76",
		"ag-charts-community": "11.3.0",
		"ag-charts-locale": "11.3.0",
		"ag-charts-types": "11.3.0",
		"ag-grid-community": "33.3.0",
		"ag-grid-react": "33.3.0",
		"chalk": "5.5.0",
		"comlink": "4.4.2",
		"elkjs": "0.11.1",
		"fuzzysort": "3.1.0",
		"idb-keyval": "6.2.1",
		"jsonpath-plus": "10.2.0",
		"keycloak-js": "15.0.2",
		"lodash-es": "4.17.21",
		"react": "19.1.0",
		"react-dom": "19.1.0",
		"react-hook-form": "7.53.0",
		"react-resizable-panels": "3.0.2",
		"react-router": "7.6.1",
		"react-router-dom": "7.6.1",
		"usehooks-ts": "3.1.0",
		"zod": "3.25.20"
	},
	"resolutions": {
		"webpack": "5.96.1",
		"webpack-cli": "5.1.4",
		"webpack-dev-server": "5.0.4",
		"webpack-merge": "5.10.0",
		"html-webpack-plugin": "5.5.0",
		"react-refresh": "0.17.0",
		"@pmmmwh/react-refresh-webpack-plugin": "0.6.0"
	},
	"overrides": {
		"webpack": "5.96.1",
		"webpack-cli": "5.1.4",
		"webpack-dev-server": "5.0.4",
		"webpack-merge": "5.10.0",
		"html-webpack-plugin": "5.5.0",
		"react-refresh": "0.17.0",
		"@pmmmwh/react-refresh-webpack-plugin": "0.6.0"
	}
}
