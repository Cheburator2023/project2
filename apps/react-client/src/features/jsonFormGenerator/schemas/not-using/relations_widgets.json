{
	"algorithmComplexity": {
		"widget": "AlgorithmComplexityWidget"
	},
	"modelsCount": {
		"widget": "NumberInputWidget"
	},
	"uncertaintyAdjustment": {
		"widget": "NumberInputWidget",
		"options": {
			"suffix": "%"
		}
	},
	"generalUncertainty": {
		"widget": "GeneralUncertaintyWidget"
	},
	"assessedInitiativesCount": {
		"widget": "UniversalDependencyWidget",
		"options": {
			"dependencies": [
				{
					"condition": "readyPromReports === 'Да'",
					"disabled": true,
					"valueToSet": 1
				}
			],
			"defaultWidget": "NumberInputWidget"
		}
	},
	"dataSourcesCount": {
		"widget": "UniversalDependencyWidget",
		"options": {
			"disabled": true,
			"disabledValue": "Нет",
			"dependencies": [
				{
					"condition": "readyPromReports === 'Нет' || productionAdditionalReports !== 'Не требуется'",
					"disabled": false
				}
			],
			"defaultWidget": "SelectWidget"
		}
	},
	"productionDeploymentChannels": {
		"widget": "ProductionDeploymentChannelsWidget"
	},
	"pilotSupportRequired": {
		"widget": "UniversalDependencyWidget",
		"options": {
			"dependencies": [
				{
					"condition": "pilotModelRequired === 'Не требуется'",
					"disabled": true,
					"valueToSet": "Не требуется",
					"widget": "TextField"
				}
			],
			"defaultWidget": "SelectWidget"
		}
	},
	"autoMlRequired": {
		"widget": "UniversalDependencyWidget",
		"options": {
			"dependencies": [
				{
					"condition": "productionDeploymentChannels.length === 0",
					"disabled": true,
					"valueToSet": "Не требуется",
					"widget": "TextField"
				}
			],
			"defaultWidget": "SelectWidget"
		}
	},
	"productionAdditionalReports": {
		"widget": "UniversalDependencyWidget",
		"options": {
			"dependencies": [
				{
					"condition": "productionDeploymentChannels.length === 0 && pilotSupportRequired === 'Не требуется'",
					"disabled": true,
					"valueToSet": "Не требуется",
					"widget": "TextField"
				}
			],
			"defaultWidget": "NumberInputWidget"
		}
	},
	"description": {
		"widget": "textarea",
		"options": {
			"rows": 5
		}
	},
	"projectName": {
		"options": {
			"placeholder": "Enter project name"
		}
	}
}
