{
	"name": "react-client",
	"version": "1.0.0",
	"private": true,
	"scripts": {
		"dev": "npm run dev:vite",
		"vite:ensure-deps": "node ./scripts/ensure-vite-deps-cache.mjs",
		"vite:clean-deps": "rm -rf .cache/vite-app/deps .cache/vite-app/deps_temp_*",
		"predev:god": "npm run vite:ensure-deps",
		"predev:vite": "npm run vite:ensure-deps",
		"dev:god": "cross-env NODE_ENV=development NO_ROLES=true vite serve",
		"dev:vite": "cross-env NODE_ENV=development vite serve",
		"dev:vite:shell": "cross-env NODE_ENV=development MF_SHELL=1 vite serve",
		"dev:god:force": "cross-env NODE_ENV=development NO_ROLES=true VITE_FORCE_DEPS=1 npm run vite:ensure-deps && cross-env NODE_ENV=development NO_ROLES=true vite serve --force",
		"dev:vite:force": "cross-env NODE_ENV=development VITE_FORCE_DEPS=1 npm run vite:ensure-deps && cross-env NODE_ENV=development vite serve --force",
		"build:vite": "cross-env NODE_ENV=production vite build",
		"start:vite": "serve -s build",
		"serve:vite": "npm run build:vite && PORT=8004 npx serve ./dist",
		"dev:webpack": "cross-env NODE_ENV=development webpack serve --mode development --config ./webpack.dev.js",
		"dev:webpack:shell": "cross-env NODE_ENV=development MF_SHELL=1 webpack serve --mode development --config ./webpack.dev.js",
		"dev:webpack:shell:proxy": "cross-env NODE_ENV=development PUBLIC_PATH=/proxy/smart-anketa-frontend/ webpack serve --mode development --config ./webpack.dev.js",
		"build:webpack": "cross-env NODE_ENV=production webpack --mode production --config webpack.prod.js",
		"build:webpack:god": "cross-env NODE_ENV=production NO_ROLES=true webpack --mode production --config webpack.prod.js",
		"serve:webpack": "npm run build:webpack && PORT=8004 npx serve ./dist",
		"serve:webpack:god": "npm run build:webpack:god && PORT=8004 npx serve ./dist",
		"prod": "npm build && npm start",
		"biome": "npx @biomejs/biome check",
		"biome:fix": "npx @biomejs/biome check --log-level=error --diagnostic-level=error --fix --unsafe ./src",
		"test": "vitest"
	},
	"dependencies": {
		"@emotion/react": "11.14.0",
		"@emotion/styled": "11.14.0",
		"@fontsource/inter": "5.2.5",
		"@minoru/react-dnd-treeview": "*",
		"@monaco-editor/react": "4.7.0",
		"@mui/icons-material": "7.1.0",
		"@mui/material": "7.1.0",
		"@mui/utils": "7.1.0",
		"@mui/x-charts": "7.29.1",
		"@mui/x-data-grid": "7.28.2",
		"@mui/x-data-grid-pro": "7.28.2",
		"@mui/x-date-pickers": "7.28.2",
		"@mui/x-date-pickers-pro": "7.28.2",
		"@mui/x-tree-view": "7.29.1",
		"@rjsf/core": "6.5.2",
		"@rjsf/mui": "6.5.2",
		"@rjsf/utils": "6.5.2",
		"@rjsf/validator-ajv8": "6.5.2",
		"@smart-anketa/api-contract": "*",
		"@smart-anketa/json-logic-ts": "*",
		"@svar-ui/react-gantt": "2.7.0",
		"@tanstack/react-query": "5.80.0",
		"@types/react": "19.1.6",
		"@types/react-dom": "19.1.5",
		"@uiw/react-md-editor": "^4.1.1",
		"@xyflow/react": "12.1.1",
		"ag-grid-enterprise": "*",
		"axios": "1.8.4",
		"date-fns": "2.30.0",
		"dnd-multi-backend": "*",
		"happy-dom": "^17.6.3",
		"html-to-image": "1.11.11",
		"mermaid": "^11.15.0",
		"nanoid": "5.0.2",
		"pretty-bytes": "6.1.1",
		"react-dnd": "*",
		"react-dnd-html5-backend": "*",
		"react-kanban-kit": "0.0.2-beta.7",
		"rehype-rewrite": "^4.0.4",
		"ulid": "2.3.0",
		"web-vitals": "4.2.4",
		"zustand": "5.0.3"
	},
	"devDependencies": {
		"@module-federation/vite": "1.4.0",
		"@pmmmwh/react-refresh-webpack-plugin": "0.6.0",
		"@svgr/rollup": "8.1.0",
		"@svgr/webpack": "6.2.1",
		"@testing-library/jest-dom": "^6.6.3",
		"@testing-library/react": "^16.3.0",
		"@testing-library/user-event": "^14.6.1",
		"@vitejs/plugin-react": "4.3.2",
		"@vitest/ui": "^3.2.4",
		"bundle-loader": "0.5.6",
		"css-loader": "7.1.2",
		"esbuild-loader": "^4.3.0",
		"file-loader": "6.2.0",
		"happy-dom": "^17.4.4",
		"html-webpack-plugin": "5.5.0",
		"react-refresh": "0.17.0",
		"style-loader": "4.0.0",
		"vite": "5.4.11",
		"vite-plugin-checker": "0.8.0",
		"vite-plugin-node-polyfills": "0.21.0",
		"vite-plugin-static-copy": "1.0.2",
		"vite-plugin-svgr": "4.2.0",
		"vite-tsconfig-paths": "5.0.1",
		"vitest": "^3.2.4",
		"webpack": "5.96.1",
		"webpack-cli": "5.1.4",
		"webpack-dev-server": "5.0.4",
		"webpack-merge": "5.10.0"
	}
}
