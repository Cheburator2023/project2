{
	"name": "nestjs-server",
	"version": "0.0.1",
	"description": "",
	"private": true,
	"scripts": {
		"dev": "nest start --watch",
		"dev:god": "cross-env NODE_ENV=development NO_ROLES=true nest start --watch",
		"build": "nest build",
		"start": "NODE_ENV=production tsx dist/main",
		"start:debug": "nest start --debug --watch",
		"prod": "npm run build && npm run start",
		"test": "jest",
		"test:unit": "jest --testPathPattern='unit'",
		"test:integration": "jest --testPathPattern='integration'",
		"test:e2e": "jest --testPathPattern='e2e' --config ./test/jest-e2e.json",
		"test:watch": "jest --watch",
		"test:cov": "jest --coverage",
		"test:ci": "jest --runInBand --detectOpenHandles --forceExit"
	},
	"dependencies": {
		"@nestjs/cli": "11.0.5",
		"@nestjs/common": "11.0.12",
		"@nestjs/config": "4.0.2",
		"@nestjs/core": "11.0.12",
		"@nestjs/graphql": "^13.1.0",
		"@nestjs/platform-express": "11.0.12",
		"@nestjs/platform-fastify": "11.0.12",
		"@nestjs/schematics": "11.0.2",
		"@nestjs/swagger": "11.1.0",
		"@nestjs/testing": "11.0.12",
		"@nestjs/typeorm": "11.0.0",
		"class-transformer": "0.5.1",
		"class-validator": "0.14.2",
		"nest-keycloak-connect": "2.0.0-alpha.1",
		"pg": "8.14.1",
		"reflect-metadata": "0.2.2",
		"typeorm": "0.3.21"
	},
	"devDependencies": {
		"@types/express": "5.0.1",
		"@types/jest": "29.5.14",
		"@types/node": "22.13.14",
		"@types/supertest": "6.0.3",
		"globals": "16.0.0",
		"jest": "29.7.0",
		"source-map-support": "0.5.21",
		"supertest": "7.1.0",
		"ts-jest": "29.2.5",
		"ts-loader": "9.5.1",
		"tsx": "4.19.3",
		"typescript": "5.8.2"
	}
}
