{
	"name": "nestjs-server",
	"version": "0.0.1",
	"description": "",
	"private": true,
	"scripts": {
		"dev": "nest start --watch",
		"dev:god": "cross-env NODE_ENV=development NO_ROLES=true nest start --watch",
		"build": "nest build",
		"build:doc-catalog": "tsx scripts/build-v2-doc-catalog.ts",
		"sync:anketa-snapshot-layout": "tsx scripts/sync-v2-anketa-snapshot-layout.ts",
		"sync:v35-factory-snapshot": "node scripts/sync-v35-factory-snapshot.mjs && npm run sync:anketa-snapshot-layout && node ../../scripts/sync-v2-arch-component-presets.mjs",
		"patch:works-catalog-logic": "node scripts/patch-works-catalog-logic.mjs",
		"start": "NODE_ENV=production tsx dist/main",
		"start:debug": "nest start --debug --watch",
		"prod": "npm run build && npm run start",
		"test": "npm run test:unit && npm run test:integration && npm run test:e2e",
		"test:unit": "jest --testPathPattern='unit'",
		"test:integration": "jest --testPathPattern='integration'",
		"test:e2e": "jest --testPathPattern='e2e' --config ./test/jest-e2e.json",
		"test:watch": "jest --watch",
		"test:cov": "jest --coverage",
		"test:ci": "jest --runInBand --detectOpenHandles --forceExit",
		"migration:run": "tsx ./node_modules/typeorm/cli.js migration:run -d ./src/ormconfig.ts",
		"migration:revert": "tsx ./node_modules/typeorm/cli.js migration:revert -d ./src/ormconfig.ts",
		"migration:run:local": "tsx ../../node_modules/typeorm/cli.js migration:run -d ./src/ormconfig.ts",
		"migration:revert:local": "tsx ../../node_modules/typeorm/cli.js migration:revert -d ./src/ormconfig.ts",
		"migration:generate": "typeorm-ts-node-commonjs migration:generate ./src/migrations/$npm_config_name -d ./src/ormconfig.ts"
	},
	"dependencies": {
		"@nestjs/cli": "11.0.5",
		"@nestjs/common": "11.0.12",
		"@nestjs/config": "4.0.2",
		"@nestjs/core": "11.0.12",
		"@nestjs/graphql": "^13.1.0",
		"@nestjs/platform-express": "11.0.12",
		"@nestjs/platform-fastify": "11.0.12",
		"@nestjs/schematics": "11.0.2",
		"@nestjs/swagger": "11.1.0",
		"@nestjs/testing": "11.0.12",
		"@nestjs/typeorm": "11.0.0",
		"class-transformer": "0.5.1",
		"class-validator": "0.14.2",
		"exceljs": "^4.4.0",
		"nest-keycloak-connect": "2.0.0-alpha.1",
		"pg": "8.14.1",
		"reflect-metadata": "0.2.2",
		"typeorm": "0.3.21"
	},
	"devDependencies": {
		"@types/express": "5.0.1",
		"@types/form-data": "^2.5.2",
		"@types/jest": "29.5.14",
		"@types/node": "22.13.14",
		"@types/supertest": "6.0.3",
		"@types/uuid": "^10.0.0",
		"globals": "16.0.0",
		"jest": "29.7.0",
		"source-map-support": "0.5.21",
		"supertest": "7.1.0",
		"ts-jest": "29.2.5",
		"ts-loader": "9.5.1",
		"tsx": "4.19.3",
		"typescript": "5.8.2"
	}
}
