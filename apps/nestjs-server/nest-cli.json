{
	"$schema": "https://json.schemastore.org/nest-cli",
	"collection": "@nestjs/schematics",
	"sourceRoot": "src",
	"compilerOptions": {
		"deleteOutDir": true,
		"assets": [
			{
				"include": "modules/anketa-v2/constants/*.snapshot.json",
				"watchAssets": true
			},
			{
				"include": "modules/anketa-v2/constants/*.registry.json",
				"watchAssets": true
			}
		]
	}
}
