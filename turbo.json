{
	"$schema": "https://turborepo.org/schema.json",
	"tasks": {
		"lib:build": {
			"dependsOn": []
		},
		"lint": {
			"dependsOn": []
		},
		"dev": {
			"dependsOn": [],
			"persistent": true,
			"cache": false
		},
		"dev:god": {
			"dependsOn": [],
			"persistent": true,
			"cache": false
		},
		"dev:no_roles": {
			"dependsOn": [],
			"persistent": true,
			"cache": false
		},
		"build": {
			"dependsOn": ["^build"],
			"cache": false
		},
		"prod": {
			"dependsOn": []
		},
		"test": {
			"dependsOn": [],
			"cache": false
		},
		"//#prettier": {
			"dependsOn": [],
			"outputs": []
		},
		"deploy": {
			"dependsOn": ["build", "test", "prettier"],
			"outputs": []
		}
	}
}
