{
	"$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
	"vcs": {
		"enabled": false,
		"clientKind": "git",
		"useIgnoreFile": false
	},
	"files": {
		"ignoreUnknown": true,
		"ignore": [
			".__mf__win",
			"**/.__mf__win",
			"**/reports/*",
			"**/.__mf__temp",
			"generated/**/*",
			"node_modules",
			"releases",
			"images",
			"dist",
			"packages/**/dist",
			"package-lock.json",
			"packages/**/package.json",
			"package.json",
			"build",
			"out",
			".git",
			".gitignore",
			"**/*.md",
			"**/*.lockb",
			"LICENSE",
			".cache/**/*",
			"src/common/api/core",
            "src/common/api/services"
		]
	},
	"formatter": {
		"enabled": true,
		"lineEnding": "lf"
	},
	"organizeImports": {
		"enabled": true
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"a11y": {
				"useButtonType": "off",
				"noSvgWithoutTitle": "off",
				"useMediaCaption": "off",
				"useKeyWithClickEvents": "off",
				"noLabelWithoutControl": "off",
				"useValidAnchor": "off"
			},
			"security": {
				"noDangerouslySetInnerHtml": "off"
			},
			"style": {
				"useNodejsImportProtocol": "off",
				"useConst": "warn",
				"noDefaultExport": "off",
				"noUnusedTemplateLiteral": "off",
				"noUselessElse": "off",
				"noNonNullAssertion": "off",
				"useTemplate": "off",
				"noParameterAssign": "warn",
				"useImportType": "off",
				"useSelfClosingElements": {
					"fix": "safe",
					"level": "warn"
				}
			},
			"correctness": {
				"noUnsafeOptionalChaining": "warn",
				"useExhaustiveDependencies": "off",
				"noUnusedImports": {
					"fix": "safe",
					"level": "warn"
				}
			},
			"complexity": {
				"useLiteralKeys": "off",
				"useOptionalChain": "off",
				"useArrowFunction": "off",
				"noBannedTypes": "off",
				"noUselessFragments": "off",
				"noForEach": "off"
			},
			"suspicious": {
				"noExplicitAny": "off",
				"noPrototypeBuiltins": "warn",
				"noArrayIndexKey": "off",
				"noAssignInExpressions": "off",
				"noThenProperty": "off"
			},
			"performance": {
				"noAccumulatingSpread": "warn",
				"noDelete": "off"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		},
		"parser": {
			"unsafeParameterDecoratorsEnabled": true
		}
	}
}
