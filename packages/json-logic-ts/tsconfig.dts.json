{
	"$schema": "https://json.schemastore.org/tsconfig",
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"module": "ESNext",
		"moduleResolution": "bundler",
		"declaration": true,
		"emitDeclarationOnly": true,
		"outDir": "dist"
	},
	"include": [
		"src/index.ts",
		"src/engine.ts",
		"src/loadEngine.cjs.ts",
		"src/truthy.ts",
		"src/types.ts"
	]
}
