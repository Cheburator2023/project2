{
	"name": "@smart-anketa/web-push",
	"version": "0.0.1",
	"private": true,
	"description": "Zero-dependency Web Push (RFC 8291) — vendored from @mmmike/web-push",
	"sideEffects": false,
	"main": "./index.ts",
	"types": "./index.ts",
	"exports": {
		".": {
			"types": "./index.ts",
			"import": "./index.ts",
			"require": "./index.ts",
			"default": "./index.ts"
		},
		"./send": {
			"types": "./send.ts",
			"import": "./send.ts",
			"require": "./send.ts",
			"default": "./send.ts"
		},
		"./vapid": {
			"types": "./vapid.ts",
			"import": "./vapid.ts",
			"require": "./vapid.ts",
			"default": "./vapid.ts"
		},
		"./client": {
			"types": "./client.ts",
			"import": "./client.ts",
			"require": "./client.ts",
			"default": "./client.ts"
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.json --noEmit",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"lint": "echo noop"
	},
	"devDependencies": {
		"typescript": "5.8.2"
	}
}
