// ============================================================================
//  Логика на РЕАЛЬНЫХ данных (SA_DATA)
//  • Работы группируются ПО АРХ. КОМПОНЕНТУ (стрим — вторичный тег).
//  • Триггеры и параметры трудоёмкости берутся из параметров того же арх. компонента.
//  • Формула — гибкое выражение (операнды, операторы × ÷ + −, скобки, округление),
//    редактируется и визуально (чипы), и вручную (текст → парсер).
// ============================================================================
(function(){
  function translit(s){
    const m={а:'a',б:'b',в:'v',г:'g',д:'d',е:'e',ё:'e',ж:'zh',з:'z',и:'i',й:'i',к:'k',л:'l',м:'m',н:'n',о:'o',п:'p',р:'r',с:'s',т:'t',у:'u',ф:'f',х:'h',ц:'c',ч:'ch',ш:'sh',щ:'sch',ъ:'',ы:'y',ь:'',э:'e',ю:'yu',я:'ya'};
    let o='',up=false;
    for(const ch of (s||'').toLowerCase()){
      if(ch===' '||ch==='/'||ch===','||ch==='('||ch===')'||ch==='-'){up=true;continue;}
      const r=m[ch]!==undefined?m[ch]:(/[a-z0-9]/.test(ch)?ch:'');
      if(up&&r){o+=r.charAt(0).toUpperCase()+r.slice(1);up=false;} else o+=r;
    }
    return o.slice(0,26);
  }
  // нормализация имени арх. компонента (регистр + префикс)
  const normComp = s => (s||'')
    .replace(/Арх\.?\s*Компонент\.?\s*/i,'')
    .replace(/процесс\s+обработки/i,'Процесс обработки')
    .replace(/объект\s+данных/i,'Объект данных')
    .replace(/система[-\s]источник/i,'Система-источник')
    .replace(/модельный\s+сервис/i,'Модельный сервис')
    .trim() || '—';

  function build(){
    const D = window.SA_DATA || {params:[],works:[]};
    const params = {}; const usedId = {};
    D.params.forEach(p=>{
      let id = translit(p.name) || 'p';
      if(usedId[id]) id = id+(usedId[id]++); else usedId[id]=1;
      const section = normComp(p.section);
      let values=[];
      if(p.type==='bool') values=[{v:'Да',coef:1.2},{v:'Нет',coef:1.0}];
      else if(p.type==='dict') values=(p.values||[]).map((v,i)=>({v, coef:+(1+0.25*i).toFixed(2)}));
      params[id]={ id, label:p.name, section, type:p.type, values, cur:(values[0]?values[0].v:'') };
    });
    const bySection = {};
    Object.values(params).forEach(p=>{ if(p.type!=='bool'&&p.type!=='dict') return; (bySection[p.section]=bySection[p.section]||[]).push(p.id); });
    const general = bySection['Параметры'] || [];
    function paramsForComponent(compFull){
      const sec = normComp(compFull);
      const own = bySection[sec] || [];
      return own.concat(general.filter(g=>own.indexOf(g)<0));
    }

    const works = D.works.map((w,i)=>{
      const id='w'+i;
      const comp=normComp(w.component);
      const pool=paramsForComponent(comp);
      const triggers=[], labor=[];
      if(pool.length){
        if(i%2===0){ const tp=params[pool[i%pool.length]]; if(tp) triggers.push({id:'t0', p:tp.id, op:'=', v:(tp.values[0]?tp.values[0].v:'')}); }
        if(pool.length>1){ const lp=params[pool[(i+1)%pool.length]]; if(lp && lp.type==='dict') labor.push({id:'l0', p:lp.id}); }
        if(i%5===0){ const lp2=params[pool[(i+2)%pool.length]]; if(lp2 && lp2.type==='dict' && labor.every(l=>l.p!==lp2.id)) labor.push({id:'l1', p:lp2.id}); }
      }
      // формула по умолчанию: H × k1 × k2 ... (CEIL 0.1)
      const tokens=[{t:'H'}];
      labor.forEach(l=>{ tokens.push({t:'op',op:'×'}); tokens.push({t:'coef',p:l.p}); });
      return { id, stream:w.stream, component:comp, name:w.name, norm:w.norm||1,
        seed:{ triggers, labor, formula:tokens, round:{mode:'CEIL', step:0.1} } };
    });

    window.SA_LOGIC = { params, works, paramsForComponent, normComp };
    return window.SA_LOGIC;
  }

  // ---------- Вычислитель выражений (операнды/операторы/скобки/округление) ----------
  const PREC={'×':2,'÷':2,'·':2,'*':2,'/':2,'+':1,'−':1,'-':1};
  function opNorm(o){ return o==='*'?'×':o==='·'?'×':o==='/'?'÷':o==='-'?'−':o; }
  window.SA_EVAL = {
    ans(answers,p){ return (answers&&answers[p.id]!=null)?answers[p.id]:p.cur; },
    coefOf(answers,p){ const a=this.ans(answers,p); const row=(p.values||[]).find(x=>x.v===a); return row?row.coef:1; },

    // значение операнда
    operandVal(tok, work, cfg, params, answers){
      if(tok.t==='H')   return cfg.norm!=null?cfg.norm:work.norm;
      if(tok.t==='num') return tok.val;
      if(tok.t==='coef'){ const p=params[tok.p]; return p?this.coefOf(answers,p):1; }
      return 0;
    },
    // shunting-yard → значение
    evalTokens(tokens, work, cfg, params, answers){
      const out=[], ops=[]; // RPN
      const pushOut=(x)=>out.push(x);
      for(const tk of tokens){
        if(tk.t==='op'){ const o=opNorm(tk.op);
          while(ops.length){ const top=ops[ops.length-1]; if(top!=='(' && PREC[top]>=PREC[o]) pushOut({op:ops.pop()}); else break; }
          ops.push(o);
        } else if(tk.t==='lp'){ ops.push('('); }
        else if(tk.t==='rp'){ while(ops.length && ops[ops.length-1]!=='(') pushOut({op:ops.pop()}); if(ops[ops.length-1]==='(') ops.pop(); }
        else { pushOut({val:this.operandVal(tk,work,cfg,params,answers)}); }
      }
      while(ops.length) pushOut({op:ops.pop()});
      const stk=[];
      for(const r of out){
        if(r.op!==undefined){ const b=stk.pop()||0, a=stk.pop()||0;
          stk.push(r.op==='×'?a*b : r.op==='÷'?a/(b||1) : r.op==='−'?a-b : a+b);
        } else stk.push(r.val);
      }
      return stk.length?stk[0]:0;
    },
    applyRound(raw, round){
      if(!round||round.mode==='NONE'||!round.step) return +raw.toFixed(3);
      const s=round.step;
      if(round.mode==='CEIL')  return +(Math.ceil(raw/s)*s).toFixed(3);
      if(round.mode==='FLOOR') return +(Math.floor(raw/s)*s).toFixed(3);
      return +(Math.round(raw/s)*s).toFixed(3);
    },
    evalWork(work, cfg, params, answers){
      const toks=(cfg.formula&&cfg.formula.length)?cfg.formula:[{t:'H'}];
      const raw=this.evalTokens(toks, work, cfg, params, answers);
      return { raw:+(+raw).toFixed(3), value:this.applyRound(+raw, cfg.round) };
    },
    kindOf(cfg){
      const toks=cfg.formula||[]; const opers=toks.filter(t=>t.t==='op').map(t=>opNorm(t.op));
      const hasParen=toks.some(t=>t.t==='lp');
      let base = opers.some(o=>o==='+'||o==='−') ? 'аддитивно-мультипликативная'
               : opers.some(o=>o==='÷') ? 'мультипликативная (÷)'
               : opers.length ? 'мультипликативная' : 'фиксированная';
      return hasParen? base+' · со скобками' : base;
    },
    trigActive(cfg, params, answers){
      const t=cfg.triggers||[]; if(!t.length) return true;
      return t.every(c=>{ const p=params[c.p]; if(!p) return true; const a=this.ans(answers,p); return c.op==='='? a===c.v : a!==c.v; });
    },

    // ---- компиляция токенов → строка ----
    stringify(tokens, params){
      return (tokens||[]).map(t=>{
        if(t.t==='H') return 'H';
        if(t.t==='num') return String(t.val);
        if(t.t==='op') return opNorm(t.op);
        if(t.t==='lp') return '(';
        if(t.t==='rp') return ')';
        if(t.t==='coef'){ const p=params[t.p]; return 'k['+(p?p.label:t.p)+']'; }
        return '';
      }).join(' ');
    },
    // ---- парсер строки → токены. H/Н=норматив, k1..kn или k[Имя]=коэф, числа, + - × ÷ * / ( ) ----
    parse(str, laborParams, params){
      const tokens=[]; const errors=[];
      const re=/\s*(H|Н|k\[[^\]]+\]|k\d+|\d+(?:[.,]\d+)?|[()+\-\u2212\u00d7\u00f7*/\u00b7])/giy;
      let m, last=0;
      str=str.trim();
      while((m=re.exec(str))){
        last=re.lastIndex; const tok=m[1];
        if(/^(H|Н)$/i.test(tok)) tokens.push({t:'H'});
        else if(/^k\d+$/i.test(tok)){ const idx=parseInt(tok.slice(1))-1; const lp=laborParams[idx]; if(lp) tokens.push({t:'coef',p:lp}); else errors.push('нет '+tok); }
        else if(/^k\[/.test(tok)){ const name=tok.slice(2,-1).trim().toLowerCase(); const id=Object.keys(params).find(k=>params[k].label.toLowerCase()===name||params[k].label.toLowerCase().startsWith(name)); if(id) tokens.push({t:'coef',p:id}); else errors.push('нет k['+name+']'); }
        else if(/^\d/.test(tok)) tokens.push({t:'num',val:parseFloat(tok.replace(',','.'))});
        else if(tok==='(') tokens.push({t:'lp'});
        else if(tok===')') tokens.push({t:'rp'});
        else tokens.push({t:'op',op:opNorm(tok)});
      }
      const rest=str.slice(last).trim();
      if(rest) errors.push('не разобрано: '+rest);
      return { tokens, errors };
    },
  };

  if(window.SA_DATA) build(); else window.SA_LOGIC_BUILD = build;
})();
